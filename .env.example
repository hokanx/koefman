# Copy to .env.local and fill in. Never commit the filled file.
#
# These two are read at BUILD time by src/integrations/supabase/client.ts.
# Vite inlines them into the bundle, so they must be set in the hosting
# provider's environment (Vercel: Settings -> Environment Variables) before
# the build runs — not at runtime. If either is missing the app renders a
# blank page with no build error.
#
# Note the key is PUBLISHABLE_KEY, not ANON_KEY. It is the same Supabase
# value; only the variable name differs from Supabase's own docs.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase edge function secrets — NOT set here.
#
# These live in the Supabase project (Dashboard -> Edge Functions -> Secrets,
# or `npx supabase secrets set`). They do not travel with a database dump, so
# they must be set again by hand in any new Supabase project or the functions
# return 500.
#
#   GEMINI_API_KEY          analyze-receipt, generate-lead-analysis
#   GEMINI_ANALYSIS_MODEL   optional, defaults to gemini-3.6-flash
#   GEMINI_RECEIPT_MODEL    optional, defaults to gemini-3.6-flash
#   RESEND_API_KEY          send-org-document-email
#   PUBLIC_APP_URL          public document links in outgoing email
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# by the Supabase runtime — do not set them manually.
